# Environment Mode
APP_ENV=development

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Keys (Modern convention)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Legacy Keys fallback
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dev / Testing
ALLOW_DEV_LOGIN=false
SUPABASE_DEV_REF=
SUPABASE_PROD_REF=

# External Services
RESEND_API_KEY=
# Sender shown on emails; must be on a domain verified in Resend
EMAIL_FROM=
# WhatsApp Cloud API (Meta). Free test number available. WHATSAPP_TEMPLATES is optional JSON, see docs/backend/OPERATIONS.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATES=
# Which channel a consultant's reply to a lead uses: auto (default: WhatsApp once the two keys above are set, email until then),
# email (always email) or whatsapp. Reminders and booking notices already send email plus a WhatsApp copy, so they need no switch.
NOTIFY_CHANNEL=auto
# API key for the AI features. Empty = every AI feature uses its rule-based fallback (the site never needs it).
# Google: create one at aistudio.google.com (a free key works). Anthropic: console.anthropic.com.
AI_PROVIDER_API_KEY=
# google (default) or anthropic. Switching vendor is only this line plus the key.
AI_PROVIDER=google
# Optional model overrides. Empty = the provider default. Run `pnpm ai:smoke` to see which models your key can call.
# fast = chatbot, handoff brief, digest note, price-band note; smart = lead briefing, Lead Desk Agent
AI_MODEL_FAST=
AI_MODEL_SMART=
# Free keys allow only a few requests per minute: set this a little under the real limit (0 = no ceiling).
# After a 429 from the API the app also pauses model calls for a minute and uses the rule-based answers.
AI_MAX_RPM=0
# How long to wait for the model before using the rule-based answer. Free-tier Gemini often needs 10-15 s, so keep these generous.
AI_TIMEOUT_FAST_MS=30000
AI_TIMEOUT_SMART_MS=25000
# Max LLM calls per feature per IST day; over the cap the rule-based fallback is used.
# All features share one provider quota, so on a free key (about 500 calls a day) use about 100, and AI_MAX_RPM=8.
AI_DAILY_CALL_CAP=5000
CRON_SECRET=
# Shared mailbox or group alias that receives internal alerts (SLA breach, price rule expiry, waiting chats...).
# Also replaces the old manager@vrooma.in / staff@vrooma.in placeholders at send time. Unset = those addresses.
ALERT_EMAIL=
# Non-production safety net: when set (and APP_ENV is not production), the outbox only ever contacts these
# addresses or @domains, e.g. "delivered@resend.dev,@yourcompany.com". Everything else is marked skipped.
OUTBOX_ALLOWLIST=
# Shared secret the telephony vendor sends as a Bearer token to POST /api/webhooks/calls (optional)
CALLS_WEBHOOK_SECRET=

# Which proxy fronts the app, for trusted client-IP resolution (rate limits, audit): vercel | cloudflare | none
# none (default) ignores every forwarded header. Set `vercel` on the Vercel production AND preview scopes.
TRUSTED_PROXY=none

# Length of the emailed sign-in code. Must equal Supabase > Authentication > Providers > Email > Email OTP Length.
NEXT_PUBLIC_AUTH_OTP_LENGTH=8
