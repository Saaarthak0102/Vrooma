# Environment Mode
APP_ENV=development

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Keys (Modern convention)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Legacy Keys fallback
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dev / Testing
ALLOW_DEV_LOGIN=false
SUPABASE_DEV_REF=
SUPABASE_PROD_REF=

# External Services
RESEND_API_KEY=
AI_PROVIDER_API_KEY=
CRON_SECRET=

# Which proxy fronts the app, for trusted client-IP resolution (rate limits, audit): vercel | cloudflare | none
# none (default) ignores every forwarded header. Set `vercel` on the Vercel production AND preview scopes.
TRUSTED_PROXY=none

# Length of the emailed sign-in code. Must equal Supabase > Authentication > Providers > Email > Email OTP Length.
NEXT_PUBLIC_AUTH_OTP_LENGTH=8
